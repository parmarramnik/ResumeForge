{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "declaration": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@resumeforge/shared-types": ["../shared-types/src/index.ts"]
    }
  },
  "include": ["src/**/*"]
}
