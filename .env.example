# =========================================================
# ResumeForge Platform - Environment Variables Configuration
# =========================================================

# Next.js Application Environment
NODE_ENV=development
PORT=3000

# Isolated Compiler Microservice Endpoint
COMPILER_SERVICE_URL=http://localhost:8000
COMPILER_TIMEOUT=8
COMPILER_MEMORY_LIMIT=512MB

# Supabase Credentials (from Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Rate Limiting Parameters (Requests per minute per user/IP)
RATE_LIMIT_COMPILE_PER_MINUTE=30
RATE_LIMIT_API_PER_MINUTE=120

# Optional Demo Mode Override (true allows full test access without Supabase keys)
ENABLE_DEMO_AUTH=false
